# desk (images/openwrt-25.12): run once at the first boot, like the image's own uci-defaults.
# One NIC on passt, which forwards SSH to the address its DHCP hands out: the LAN takes its
# address by DHCP instead of serving 192.168.1.1, and its firewall zone lets SSH and LuCI in.
uci set network.lan.proto='dhcp'
uci -q delete network.lan.ipaddr
uci -q delete network.lan.netmask
uci -q delete network.lan.ip6assign
uci commit network
uci set dhcp.lan.ignore='1'
uci set dhcp.lan.ra='disabled'
uci set dhcp.lan.dhcpv6='disabled'
uci commit dhcp
# Every desk image runs in this zone; desk clock takes times without a zone as its local time.
uci set system.@system[0].hostname='desk-openwrt'
uci set system.@system[0].zonename='Europe/Warsaw'
uci set system.@system[0].timezone='CET-1CEST,M3.5.0,M10.5.0/3'
uci commit system
# The password of every desk image's user is its name (LuCI asks for it).
(echo '@PASSWORD@'; sleep 1; echo '@PASSWORD@') | passwd root >/dev/null 2>&1
exit 0
